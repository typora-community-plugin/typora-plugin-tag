{
  "version": 2,
  "settings": {
    "displayLang": "zh-cn",
    "githubProxy": "github",
    "showNotSupportedFile": false,
    "keepSearchResult": false,
    "showSearchResultFullPath": false,
    "showRibbon": true,
    "hideExtensionInFileTab": false,
    "openLinkInCurrentWin": true,
    "quickOpenInCurrentWin": true,
    "ignoreFile": true,
    "ignoreFileGlob": ".git",
    "ribbonState": {
      "core.search": {
        "visible": true,
        "order": 0
      },
      "core.file-explorer": {
        "visible": true,
        "order": 1
      },
      "core.outline": {
        "visible": true,
        "order": 2
      },
      "tag": {
        "visible": true,
        "order": 3
      }
    },
    "internalPlugin.enabledPlugins": {
      "internal.metadata": true,
      "internal.workspace": true
    },
    "advancedSearchMode": true
  }
}